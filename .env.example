# Copy to `.env` at the repo root (gitignored — never commit the real one).
# Consumed by scripts/ask-code.sh, scripts/sf_query.py, and .mcp.json.

# --- ask-code MCP server (.mcp.json, SSE transport) ---
# Bearer token for the n8n ask-code SSE endpoint
# (https://sami-team.app.n8n.cloud/mcp/ask-the-code/sse). Expanded into the
# `Authorization: Bearer ${ASK_CODE_MCP_TOKEN}` header — the token only, no scheme.
ASK_CODE_MCP_TOKEN=

# --- ERP ask-the-code (scripts/ask-code.sh) ---
# Sent verbatim as the `Authorization` header to https://erpbackendpro.maids.cc
# (include the scheme if the ERP expects it, e.g. "Bearer eyJ..." — otherwise the raw token).
ERP_AUTH_TOKEN=
# Sent verbatim as the `secc-ch-ua-platform` header.
ERP_SECC_PLATFORM=
# Optional: seconds to wait for an answer (default 600).
# ASK_CODE_TIMEOUT=600

# --- Snowflake (scripts/sf_query.py) — key-pair auth, NO passphrase ---
SNOWFLAKE_ACCOUNT=          # e.g. ab12345.eu-central-1  (org-account locator)
SNOWFLAKE_USERNAME=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# PKCS#8 PEM, single line, real newlines written as literal \n (the script un-escapes them).
# Must be an unencrypted key (password=None in the script).
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"
