{
 "id": "CopNHNsXUzFO59bW",
 "name": "MV Monthly Payment - 2-Score chunk (graph fixture)",
 "nodes": [
  {
   "name": "Chunk In",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.2,
   "parameters": {}
  },
  {
   "name": "Fan Out Contracts",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// ERP-COMPLIANCE: budget-gate-in-caller - Stage 1 costs the whole run before dispatch.\n// ERP-COMPLIANCE: lease-held-by-caller - Stage 1 holds the lease; acquiring here would deadlock.\n"
   }
  },
  {
   "name": "Read Payment Ledger",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "parameters": {
    "url": "https://erpbackendpro.maids.cc/accounting/payments/page/advancesearch?page=0&size=1000",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 2,
       "batchInterval": 500
      }
     },
     "timeout": 60000
    },
    "jsonBody": "={{ JSON.stringify([{ property: \"contract.id\", value: String($json.contractId) }]) }}"
   },
   "alwaysOutputData": true,
   "onError": "continueRegularOutput"
  },
  {
   "name": "Read Contract Details",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "parameters": {
    "url": "={{ 'https://erpbackendpro.maids.cc/clientmgmt/client/get-client-details/' + $('Fan Out Contracts').item.json.clientId }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 2,
       "batchInterval": 500
      }
     },
     "timeout": 60000
    }
   },
   "alwaysOutputData": true,
   "onError": "continueRegularOutput"
  },
  {
   "name": "Score Contract Month",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// the scorer, byte-identical to scorer.stage2.js\n"
   },
   "notes": "ERP-COMPLIANCE: no-breaker-because this node runs once PER ITEM and cannot see a batch. The breaker is Chunk Summary, which runs once for the whole chunk and throws."
  },
  {
   "name": "Write Case Row",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "parameters": {},
   "alwaysOutputData": true
  },
  {
   "name": "Chunk Summary",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "throw new Error('ERP_SESSION_INACTIVE');\n"
   }
  }
 ],
 "connections": {
  "Chunk In": {
   "main": [
    [
     {
      "node": "Fan Out Contracts"
     }
    ]
   ]
  },
  "Fan Out Contracts": {
   "main": [
    [
     {
      "node": "Read Payment Ledger"
     }
    ]
   ]
  },
  "Read Payment Ledger": {
   "main": [
    [
     {
      "node": "Read Contract Details"
     }
    ]
   ]
  },
  "Read Contract Details": {
   "main": [
    [
     {
      "node": "Score Contract Month"
     }
    ]
   ]
  },
  "Score Contract Month": {
   "main": [
    [
     {
      "node": "Write Case Row"
     }
    ]
   ]
  },
  "Write Case Row": {
   "main": [
    [
     {
      "node": "Chunk Summary"
     }
    ]
   ]
  }
 }
}