{
 "id": "9jOMFEC2zEWy2RHM",
 "name": "MV Monthly Payment - 0-Sweep Population (graph fixture)",
 "nodes": [
  {
   "name": "Sweep In",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.2,
   "parameters": {}
  },
  {
   "name": "Plan Page Groups",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// plans page groups; no ERP\n"
   }
  },
  {
   "name": "Each Group",
   "type": "n8n-nodes-base.splitInBatches",
   "typeVersion": 3,
   "parameters": {}
  },
  {
   "name": "Fan Out Group Pages",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// ERP-COMPLIANCE: budget-gate-in-caller - Stage 1 costs the whole run before dispatch.\n// ERP-COMPLIANCE: lease-held-by-caller - Stage 1 holds the lease; acquiring here would deadlock.\n"
   }
  },
  {
   "name": "Fetch Population Page",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "parameters": {
    "url": "={{ 'https://erpbackendpro.maids.cc/clientmgmt/contract/search/page?page=' + $json.page + '&size=' + $json.size }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 1,
       "batchInterval": 1000
      }
     },
     "timeout": 60000
    }
   },
   "alwaysOutputData": true,
   "onError": "continueRegularOutput"
  },
  {
   "name": "Project Group",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// ERP-COMPLIANCE: no-breaker-because this sweep's breaker is the GROUP boundary, not this node.\n// Group Healthy? aborts on the FIRST failing page of a group; the generated block needs five.\n"
   }
  },
  {
   "name": "Group Healthy?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "parameters": {}
  },
  {
   "name": "Circuit Breaker Tripped",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// returns aborted with NO rows; Stage 1 throws on aborted\n"
   }
  },
  {
   "name": "Sweep Result",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// reconciles against expectedTotal with a tolerance\n"
   }
  }
 ],
 "connections": {
  "Sweep In": {
   "main": [
    [
     {
      "node": "Plan Page Groups"
     }
    ]
   ]
  },
  "Plan Page Groups": {
   "main": [
    [
     {
      "node": "Each Group"
     }
    ]
   ]
  },
  "Each Group": {
   "main": [
    [
     {
      "node": "Sweep Result"
     }
    ],
    [
     {
      "node": "Fan Out Group Pages"
     }
    ]
   ]
  },
  "Fan Out Group Pages": {
   "main": [
    [
     {
      "node": "Fetch Population Page"
     }
    ]
   ]
  },
  "Fetch Population Page": {
   "main": [
    [
     {
      "node": "Project Group"
     }
    ]
   ]
  },
  "Project Group": {
   "main": [
    [
     {
      "node": "Group Healthy?"
     }
    ]
   ]
  },
  "Group Healthy?": {
   "main": [
    [
     {
      "node": "Each Group"
     }
    ],
    [
     {
      "node": "Circuit Breaker Tripped"
     }
    ]
   ]
  }
 }
}